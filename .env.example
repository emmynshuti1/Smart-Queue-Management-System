PORT=5000
NODE_ENV=development

# PostgreSQL — either DATABASE_URL (Railway/Render/Heroku style) ...
# DATABASE_URL=postgres://user:password@host:5432/sqhs_db
# DB_SSL=true
# ... or individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=sqhs_db

# JWT signing secret — at least 32 random characters. Required when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Password for the first 'admin' account, created only when the users table is empty.
# If left blank a random password is generated and printed once in the server log.
ADMIN_INITIAL_PASSWORD=

# Phone numbers entered as 07XXXXXXXX are converted using this country code.
DEFAULT_COUNTRY_CODE=250

# Twilio SMS — leave blank if you have no SMS provider. Messages are then logged with
# status "not_configured" and are NOT delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Only needed if the frontend is served from a different origin than the API.
# FRONTEND_URL=http://localhost:3000
